<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.vitor-brack</groupId>
    <artifactId>NetSpeedBar</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <exec.mainClass>io.github.vitor_brack.netspeedbar.NetSpeedBar</exec.mainClass>
        <jna.version>5.19.1</jna.version>
    </properties>

    <dependencies>
        <!-- JNA: acesso direto a API Win32 (user32, gdi32, iphlpapi) a partir do Java -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>${jna.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>NetSpeedBar</finalName>
        <plugins>
            <!-- Gera um unico .jar executavel (com o JNA dentro): javaw -jar target\NetSpeedBar.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <!-- O programa so roda no Windows: descarta as DLLs nativas dos outros sistemas -->
                                    <artifact>net.java.dev.jna:jna</artifact>
                                    <includes>
                                        <include>com/sun/jna/*</include>
                                        <include>com/sun/jna/ptr/**</include>
                                        <include>com/sun/jna/win32/**</include>
                                        <include>com/sun/jna/internal/**</include>
                                        <include>com/sun/jna/win32-x86-64/**</include>
                                        <include>com/sun/jna/win32-aarch64/**</include>
                                        <include>META-INF/**</include>
                                    </includes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
